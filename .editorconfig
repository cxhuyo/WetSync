root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{gradle,xml,yml,yaml,json,prop}]
indent_size = 4

[*.{md,markdown}]
trim_trailing_whitespace = false

[*.bat]
end_of_line = crlf

[gradlew]
end_of_line = lf
