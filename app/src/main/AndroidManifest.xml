<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      Android 11+ 包可见性：模块页要读小布输入法的版本号，还要能拉起 LSPosed 管理器。
      没有这段 <queries>，getPackageInfo / 隐式跳转都会 NameNotFound。
    -->
    <queries>
        <package android:name="com.oplus.keyboard" />
        <package android:name="org.lsposed.manager" />
        <package android:name="me.yun.lspilot" />
        <package android:name="org.lsposed.lspatch" />
    </queries>

    <application
        android:name=".WetSyncApp"
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:allowBackup="false"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <!-- 模块主页：状态、版本、申请作用域。独立于小布输入法，不注入宿主 UI。 -->
        <activity
            android:name=".StatusActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/AppTheme">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 「关于」：模块信息 + 赞赏支持 -->
        <activity
            android:name=".AboutActivity"
            android:exported="false"
            android:label="关于"
            android:theme="@style/AppTheme" />
    </application>
</manifest>
